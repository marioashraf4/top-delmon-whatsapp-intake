# Copy to .env and fill in real values. NEVER commit .env.

# --- Meta / WhatsApp Cloud API ---
META_APP_SECRET=your_meta_app_secret        # used to verify X-Hub-Signature-256
META_VERIFY_TOKEN=your_webhook_verify_token # you choose it; must match the Meta dashboard
META_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# GRAPH_API_VERSION=v23.0

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain verified in Resend before you can email real clients.
EMAIL_FROM=Top Delmon <onboarding@resend.dev>

# --- Server / storage (all optional) ---
# PORT=3000                       # Render injects PORT automatically
# DATABASE_PATH=./data/app.db     # on Render use a persistent-disk path, e.g. /var/data/app.db
# NODE_ENV=production
# RESEND_TIMEOUT_MS=8000
# WHATSAPP_TIMEOUT_MS=7000
# LEASE_MS=60000
# MAX_ATTEMPTS=8
